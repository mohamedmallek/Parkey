pipeline {
    agent any

    tools {
        // NodeJS pour build/tests Angular (meme installation que le backend)
        nodejs 'NodeJS22'
    }

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    environment {
        SERVICE_DIR    = 'pothole-angular'
        IMAGE          = 'mallek21/pothole-angular'
        CONTAINER_NAME = 'pothole-angular'
        APP_PORT       = '80'
        TAG            = "${env.BUILD_NUMBER}"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install & Build') {
            steps {
                dir("${SERVICE_DIR}") {
                    sh '''
                        set -eu
                        node -v
                        npm -v
                        npm ci
                        npm run build -- --configuration production
                        ls -la dist/pothole-angular/browser
                    '''
                    archiveArtifacts artifacts: 'dist/pothole-angular/browser/**', fingerprint: true, allowEmptyArchive: false
                }
            }
        }

        stage('Tests & Coverage') {
            steps {
                dir("${SERVICE_DIR}") {
                    sh '''
                        set -eu
                        npx ng test --coverage --coverage-reporters=lcov --watch=false
                        test -f coverage/pothole-angular/lcov.info
                        echo "Rapport de couverture : coverage/pothole-angular/lcov.info"
                    '''
                }
            }
        }

        stage('Analyse SonarQube') {
            steps {
                dir("${SERVICE_DIR}") {
                    script {
                        // Le scanner SonarQube (CLI standalone, base Java) exige Java 21+.
                        def jdk21Home = tool name: 'JDK21', type: 'jdk'
                        def scannerHome = tool name: 'SonarScanner', type: 'hudson.plugins.sonar.SonarRunnerInstallation'
                        withEnv(["JAVA_HOME=${jdk21Home}", "PATH+JDK21=${jdk21Home}/bin", "PATH+SCANNER=${scannerHome}/bin"]) {
                            withSonarQubeEnv(installationName: 'SonarQube',
                                             credentialsId: 'sonarqube-token') {
                                sh '''
                                    set -eu
                                    java -version
                                    sonar-scanner \
                                      -Dsonar.projectKey=pothole-angular \
                                      -Dsonar.projectName="Pothole Angular" \
                                      -Dsonar.sources=src \
                                      -Dsonar.exclusions=**/*.spec.ts \
                                      -Dsonar.tests=src \
                                      -Dsonar.test.inclusions=**/*.spec.ts \
                                      -Dsonar.javascript.lcov.reportPaths=coverage/pothole-angular/lcov.info \
                                      -Dsonar.typescript.lcov.reportPaths=coverage/pothole-angular/lcov.info
                                '''
                            }
                        }
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                dir("${SERVICE_DIR}") {
                    withSonarQubeEnv(installationName: 'SonarQube',
                                     credentialsId: 'sonarqube-token') {
                        sh '''
                            set -eu
                            node scripts/wait-quality-gate.js
                        '''
                    }
                }
            }
        }

        stage('Image Docker') {
            steps {
                dir("${SERVICE_DIR}") {
                    withCredentials([usernamePassword(credentialsId: 'dockerhub-credentials',
                                                       usernameVariable: 'REG_USER',
                                                       passwordVariable: 'REG_PASS')]) {
                        sh '''
                            set -e
                            echo "$REG_PASS" | docker login -u "$REG_USER" --password-stdin
                            docker build -t "$IMAGE:$TAG" -t "$IMAGE:latest" .
                            push_with_retry() {
                                ref="$1"
                                for attempt in 1 2 3 4 5; do
                                    if docker push "$ref"; then
                                        return 0
                                    fi
                                    echo "Push echoue (tentative $attempt/5), nouvel essai dans 10s..."
                                    sleep 10
                                done
                                return 1
                            }
                            if push_with_retry "$IMAGE:$TAG" && push_with_retry "$IMAGE:latest"; then
                                echo "Image publiee : $IMAGE:$TAG"
                            else
                                echo "ERREUR : Docker Hub inaccessible."
                                exit 1
                            fi
                            docker logout || true
                        '''
                    }
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                dir("${SERVICE_DIR}") {
                    sh '''
                        set -e
                        kubectl version --client
                        kubectl apply -f k8s/
                        kubectl -n parkey set image deployment/pothole-angular pothole-angular="$IMAGE:$TAG"
                        kubectl -n parkey rollout status deployment/pothole-angular --timeout=180s
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "Pipeline Pothole Angular termine. Image: ${IMAGE}:${BUILD_NUMBER}"
        }
        failure {
            echo 'Le pipeline Pothole Angular a echoue.'
        }
        cleanup {
            cleanWs()
        }
    }
}
